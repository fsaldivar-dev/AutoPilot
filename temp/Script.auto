# Script.auto
# Flujo: Login con PIN + Captura con imagen inyectada
#
# Lanzar con: auto launch "shajaru.Test-Automatitacion" --env AUTOPILOT_CAMERA_IMAGE=/tmp/autopilot-camera-feed.jpg
# Ejecutar:   auto run temp/Script.auto

# --- Login ---
waitFor "Usar PIN" 5
tap "Usar PIN"

waitFor "Confirmar" 3
tap "1"
tap "2"
tap "3"
tap "4"
tap "Confirmar"

# --- Esperar pantalla principal ---
waitFor "Inicio" 5
screenshot temp/home.png

# --- Navegar a Capturar ---
tap "Capturar"
waitFor "Camera" 3
screenshot temp/capturar.png

# --- Capturar foto (usa AUTOPILOT_CAMERA_IMAGE) ---
# El boton Camera esta en [284,575 61x61], centro = 314,605
tapAt 314 605
waitFor "capturadas" 5
screenshot temp/despues-captura.png
