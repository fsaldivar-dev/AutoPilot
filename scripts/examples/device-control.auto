# device-control.auto
# Test new device control commands
#
# Usage: auto run scripts/examples/device-control.auto        (iOS)
#        auto-android run scripts/examples/device-control.auto (Android)

ping

# === Appearance ===
setAppearance dark
wait 1
screenshot screenshots/dark-mode.png
setAppearance light
wait 1
screenshot screenshots/light-mode.png

# === Keyboard ===
launch dev.autopilot.test.Explorea
waitFor "Explorea" 10
pressKey home
wait 2

# === Lock/Unlock ===
lockDevice
wait 2
unlockDevice
wait 2
screenshot screenshots/unlocked.png

# === Location ===
setLocation 19.4326 -99.1332
wait 1

# === Screen Recording ===
startRecording
wait 3
stopRecording screenshots/recording.mp4
