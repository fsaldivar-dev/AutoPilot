# ios-camera-qr-ocr.auto
# Test E2E de cámara iOS: QR + OCR con imágenes mock inyectadas.
#
# CLAVE (anti "mentira en verde"): el test NO verifica el label de status
# ("QR detectado" / "Texto detectado") — ese aparece verde aunque el
# reconocimiento haya leído basura. Verifica el CONTENIDO REAL que decodificó
# Vision.framework:
#   - QR  → "AUTOPILOT-QR-TEST-2026"  (payload del qr-autopilot.png)
#   - OCR → "AutoPilot OCR Test"       (texto del ocr-test.png)
# waitFor del contenido es una aserción real: si el QR/OCR lee mal, el texto
# esperado nunca aparece → timeout → test rojo honesto. (`exists` NO sirve
# como aserción: reporta ok=true aunque devuelva NO — es una consulta.)
#
# Requiere: CameraTestApp instalada, simulador booteado.
# Uso: auto run scripts/examples/ios-camera-qr-ocr.auto

$qr = scripts/demo-images/qr-autopilot.png
$ocr = scripts/demo-images/ocr-test.png

# --- SETUP: abrir la app con el QR mock ---
launch dev.autopilot.test.CameraTestApp --inject $qr
waitFor "Camara lista" 15

# --- TEST QR: Vision decodifica el QR y muestra su payload ---
tap "QR"
waitFor "Escanear QR" 8
tap "Escanear QR"
waitFor "AUTOPILOT-QR-TEST-2026" 12

# --- TEST OCR: hot-swap a imagen con texto; Vision lo reconoce ---
inject $ocr
tap "OCR"
waitFor "Reconocer Texto" 8
tap "Reconocer Texto"
waitFor "AutoPilot OCR Test" 12
