# ios-camera-qr-ocr.auto
# Test E2E de cámara iOS: QR + OCR + captura, con imágenes mock inyectadas.
#
# CLAVE (anti "mentira en verde"): el test verifica el CONTENIDO REAL que
# procesó la app — no el label de status ("QR detectado"/"capturada"), que
# sale verde aunque la app haya leído basura o llegado una imagen negra.
#   - QR      → "AUTOPILOT-QR-TEST-2026"  (payload que Vision decodifica)
#   - OCR     → "AutoPilot OCR Test"        (texto que Vision reconoce)
#   - CameraX → "1206×2622"                 (dimensiones del fingerprint de la
#                                             imagen capturada; el hash sha
#                                             10c45006 verifica el contenido exacto)
# waitFor del contenido es aserción real: si el reconocimiento/captura falla,
# el valor esperado no aparece → timeout → test rojo honesto.
#
# Requiere: CameraTestApp instalada, simulador booteado.
# Uso: auto run scripts/examples/ios-camera-qr-ocr.auto

$qr = scripts/demo-images/qr-autopilot.png
$ocr = scripts/demo-images/ocr-test.png
$foto = scripts/demo-images/foto-1.jpg

# --- SETUP: abrir la app con el QR mock ---
launch dev.autopilot.test.CameraTestApp --inject $qr
waitFor "Camara lista" 15

# --- TEST QR: Vision decodifica el QR y muestra su payload ---
tap "QR"
waitFor "Escanear QR" 8
tap "Escanear QR"
waitFor "AUTOPILOT-QR-TEST-2026" 12

# --- TEST OCR: hot-swap a imagen con texto; Vision lo reconoce ---
inject $ocr
tap "OCR"
waitFor "Reconocer Texto" 8
tap "Reconocer Texto"
waitFor "AutoPilot OCR Test" 12

# --- TEST CameraX: captura la imagen inyectada; verifica su fingerprint ---
inject $foto
tap "CameraX"
waitFor "Capturar Foto" 8
tap "Capturar Foto"
waitFor "1206×2622" 12
